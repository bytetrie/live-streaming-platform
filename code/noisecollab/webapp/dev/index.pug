<!doctype html>
html
    head
        meta(charset="utf-8")
        title noisecollab
        meta(name="description" content="noisecollab Collaboration")
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(href="main.css" type="text/css" rel="stylesheet")
        script
            |(function() {document.querySelector("html").className = "js"})()
    body
        div(id="no-js-wrap")
            h1
                a(href="/") noisecollab
            p This is a simplified version of the app.
            p The audio below is the main loop. The form can be used to contribute audio to this loop.
            p HTML Audio Player (does not loop seamlessly, will require refresh to reload master)
            audio(src="/api/master.wav" controls="controls" loop="loop")
            p Audio file upload submit form (will reload page)
            p Please limit files to no more than 2 seconds, <200kB and WAV Format only.
            form(action="/api/upload" method="POST" id="audioFileForm" enctype="multipart/form-data")
                input(type="file" id="audioFile" name="fileupload")
                input(type="hidden" name="formUpload" value="true")
                button(type="submit") Submit Audio
        div(id="contentWrap" class="contentWrap")

        script(src="main.js")
        if !prod
            script
                | document.write('<script src="http://' + (location.host || 'localhost').split(':')[0] +
                | ':35729/livereload.js?snipver=1"></' + 'script>')